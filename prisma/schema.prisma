// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  KARYAWAN
}

enum PaymentMethod {
  CASH
  QRIS
  TRANSFER
}

model User {
  id           String        @id @default(cuid())
  name         String
  username     String        @unique
  password     String
  role         String        @default("KARYAWAN") // "ADMIN" or "KARYAWAN"
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id               String            @id @default(cuid())
  sku              String            @unique
  barcode          String            @unique
  name             String
  categoryId       String
  category         Category          @relation(fields: [categoryId], references: [id])
  costPrice        Float             // Harga Beli / HPP Modal
  sellingPrice     Float             // Harga Jual
  stock            Int               @default(0) // Sisa stok saat ini
  minStock         Int               @default(5) // Batas alert stok menipis
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  transactionItems TransactionItem[]

  @@index([barcode])
  @@index([name])
}

model Transaction {
  id             String            @id @default(cuid())
  invoiceNumber  String            @unique // e.g. TRX-20261106-0001
  cashierId      String
  cashier        User              @relation(fields: [cashierId], references: [id])
  totalAmount    Float             // Total Belanja (setelah diskon)
  totalCost      Float             // Total HPP (untuk laba kotor)
  discountAmount Float             @default(0) // Nilai diskon potongan harga
  cashPaid       Float             // Jumlah Uang Diterima
  changeDue      Float             // Kembalian
  paymentMethod  String            @default("CASH") // CASH, QRIS, TRANSFER
  customerName   String?
  customerPhone  String?
  createdAt      DateTime          @default(now())
  items          TransactionItem[]

  @@index([invoiceNumber])
  @@index([createdAt])
}

model TransactionItem {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  productId     String
  product       Product     @relation(fields: [productId], references: [id])
  qty           Int
  costPrice     Float       // HPP saat transaksi terjadi
  sellingPrice  Float       // Harga jual saat transaksi terjadi
  subtotal      Float       // qty * sellingPrice
}

model Shift {
  id                String    @id @default(cuid())
  cashierId         String
  cashierName       String
  shiftType         String    @default("SHIFT_1") // SHIFT_1, SHIFT_2, FULL
  openingFloat      Float     @default(0)         // Modal awal laci kasir
  closingCash       Float?                        // Uang fisik saat tutup kasir
  expectedCash      Float?                        // Dihitung sistem: openingFloat + totalCashSales
  totalCashSales    Float     @default(0)
  totalQrisSales    Float     @default(0)
  totalTransactions Int       @default(0)
  notes             String?
  status            String    @default("OPEN")    // OPEN, CLOSED
  openedAt          DateTime  @default(now())
  closedAt          DateTime?

  @@index([status])
  @@index([openedAt])
}

